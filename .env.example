# Ollama 설정
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# 컨텍스트 창 크기 (토큰 수) - 클수록 더 긴 대화 가능, RAM 사용 증가
# phi4-mini: 최대 16384 / llama3.1:8b: 최대 131072
# 32GB RAM 기준 8192~16384 권장
OLLAMA_CTX=8192

# 포트 설정
PORT=3000

# 웹 검색 강화 (선택사항 - 없으면 DuckDuckGo 무료 API 사용)
# Tavily API 키: https://tavily.com (월 1000회 무료)
TAVILY_API_KEY=
