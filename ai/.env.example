# ── LLM 제공자 선택 ──────────────────────────────────
# "groq" 또는 "gemini" 중 하나 선택
LLM_PROVIDER=groq

# ── Groq 설정 (무료) ──────────────────────────────────
# 가입: https://console.groq.com
# 가입 안 될 경우 → Gmail 사용 or 아래 Gemini로 전환
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Google Gemini 설정 (무료, 구글 계정으로 간편 가입) ──
# 키 발급: https://aistudio.google.com/app/apikey
# Groq 가입이 안 될 때 이쪽 사용 → LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── 데이터 저장 경로 ──────────────────────────────────
# Render 무료: /tmp 사용 (서버 재시작 시 초기화됨)
# Render 유료 Disk or Railway: /app/data 사용 (영구 저장)
DB_PATH=/tmp/memory.db
CHROMA_PATH=/tmp/chroma

# ── OneDrive 백업 (선택) ──────────────────────────────
# Azure Portal에서 앱 등록 후 입력
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_TENANT_ID=common
