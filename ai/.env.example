# ── LLM 제공자 선택 ──────────────────────────────────
# "auto"(기본, 폴백 체인 자동 사용) 또는 claude/zen/openrouter/groq/gemini/ollama/local 중 강제 지정
LLM_PROVIDER=auto

# ── Ollama 로컬 생성형 모델 (API 키 없음) ─────────────
# 1) Ollama 설치  2) `ollama pull qwen3:4b`  3) 아래 주석 해제
# 같은 PC/서버에서 실행할 때는 기본 주소를 그대로 사용합니다.
# 원격 주소를 쓰면 대화 내용이 그 서버로 전달되므로 신뢰하는 사설 서버만 지정하세요.
# OLLAMA_MODEL=qwen3:4b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ── Anthropic Claude (추천, 유료) ────────────────────
# 키 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OpenCode Zen (무료 모델 게이트웨이) ───────────────
# 키 발급: https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=
ZEN_MODEL=deepseek-v4-flash-free

# ── OpenRouter (무료 모델, 한도 없음) ─────────────────
# 키 발급: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Groq (무료, 하루 14,400건) ────────────────────────
# 키 발급: https://console.groq.com
# llama-3.3-70b-versatile은 2026-08월부터 Groq가 서빙을 중단할 예정이라
# llm.py의 코드 기본값을 openai/gpt-oss-120b로 이미 바꿔뒀음 — 이 예시 파일도
# 그 값과 맞춰, 값을 비워두면(주석 처리) 코드 기본값을 그대로 쓰게 한다.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ── Google Gemini (무료, 하루 1,500건) ────────────────
# 키 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Mistral AI (무료, 카드 불필요 — 전화번호 인증만 필요, 월 약 10억 토큰) ──
# 6순위 안전망: 위 5개 제공자가 전부 실패/소진됐을 때만 사용됨
# 키 발급: https://console.mistral.ai (가입 → 전화번호 인증 → API 키)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Cohere (무료 Trial, 카드 불필요 — 가입 시 자동 발급, 월 1,000건) ──────
# 7순위 안전망(최후): 위 6개 제공자가 전부 실패/소진됐을 때만 사용됨
# 키 발급: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_MODEL=command-r

# ── DB 저장 (Turso 클라우드 — 권장) ───────────────────
# 가입: https://turso.tech (무료)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 위 두 값을 설정하지 않으면 로컬 SQLite로 자동 전환 (재배포 시 데이터 유실 가능)
# DB_PATH=/app/data/memory.db

# ── 소유자·관리 API 접근 토큰 (필수) ──────────────────
# 일반 소유자 채팅은 X-Admin-Token 헤더, 관리 API는 token 파라미터로 검증한다.
# 미설정 시 공개되는 것이 아니라 소유자 채팅·관리 기능이 안전하게 차단된다.
BACKUP_TOKEN=

# ── 기억 개인정보·보존 정책 (선택, 아래는 기본값) ──────
# 검색 관측 질문은 원문 대신 HMAC으로 저장한다. 별도 salt가 없으면 BACKUP_TOKEN 사용.
MEMORY_TELEMETRY_SALT=
# 보존정책은 자동 실행되지 않으며 /admin/memory-retention 기본 호출은 미리보기만 한다.
CONVERSATION_RETENTION_DAYS=90
MEMORY_CANDIDATE_PENDING_DAYS=45
MEMORY_CANDIDATE_HISTORY_DAYS=365
MEMORY_RETRIEVAL_RETENTION_DAYS=30

# ── Google Drive 백업 (선택) ──────────────────────────
# Google Cloud Console에서 OAuth2 클라이언트 발급
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=

# ── 주식 분석 (선택) ───────────────────────────────────
DART_API_KEY=
BOK_API_KEY=
KRX_ID=
KRX_PW=

# ── 법령 검색 (선택) ───────────────────────────────────
# 키 발급: https://open.law.go.kr
# 2026-08-30부터 이 키는 "배포된 서버"(Render 등)에 설정해야 함 — GitHub Actions는
# git에 결과를 커밋하는 대신 POST /admin/refresh-law-cache를 호출해 서버가 직접
# 수집·저장하도록 바뀌었음(브랜치 불일치로 갱신분이 서비스에 반영 안 되던 문제 해결)
LAW_API_KEY=

# ── 여행경보(외교부 해외안전여행) 자동 수집 (선택) ─────────
# 키 발급: https://www.data.go.kr/data/15076237/openapi.do (활용신청 → 인증키 발급)
# LAW_API_KEY와 동일하게 "배포된 서버"에 설정 — GitHub Actions(update_travel_alerts.yml)는
# POST /admin/refresh-travel-alerts를 호출만 하고, 실제 수집·DB 저장은 서버가 수행함
TRAVEL_ALERT_API_KEY=
# 장기기억 출처별 기본 유효기간(일). 만료된 기억은 검색·답변 근거에서 자동 제외됩니다.
MEMORY_VALIDITY_LAW_DAYS=30
MEMORY_VALIDITY_WEB_DAYS=14
MEMORY_VALIDITY_KB_AUGMENTED_DAYS=180
MEMORY_VALIDITY_GENERATED_DAYS=90
MEMORY_VALIDITY_APPROVED_DAYS=180
MEMORY_VALIDITY_TRAVEL_DAYS=7
MEMORY_REVALIDATION_RETENTION_DAYS=365
MEMORY_QUALITY_EVAL_RETENTION_DAYS=365
MEMORY_VALIDITY_PREFERENCE_DAYS=365
MEMORY_VALIDITY_CONTEXT_DAYS=14
MEMORY_SEMANTIC_CHECK_TIMEOUT=25

# ── 로컬 생성형 모델 (실험적, 기본 비활성 — 권장하지 않음) ─────
# 외부 LLM API가 전부 없을 때 순수 추출(engine._local_synthesize) 대신 소형
# GGUF 모델로 문장을 생성해보는 마지막 단계. 둘 다 비워두면(기본값) 완전히
# 비활성이며 llama_cpp도 임포트하지 않아 기존 배포에 아무 영향이 없다.
#
# 경고 (2026-09-13 실측): Render 무료 티어(512MB RAM/0.1 CPU) 예산 안에 드는
# 크기의 모델은 전부 문제가 있었음 — SmolLM2-135M은 한국어가 깨지고,
# Gemma-3-270M은 한국어는 자연스럽지만 참고자료를 무시하고 지어냄(할루시네이션),
# Qwen2.5-0.5B는 파일 크기(491MB)만으로 이미 예산을 거의 다 씀. 지금 이미 구축된
# 순수 추출 엔진이 이 크기의 생성 모델보다 더 안전·정확하므로 무료 티어에서는
# 켜지 않는 것을 권장한다. 유료 플랜으로 RAM에 여유가 생기면(예: 2GB 이상)
# LOCAL_GEN_MODEL_URL을 1.5B~3B급 다국어 모델로 바꿔 켜는 것을 권장 — 코드
# 변경 없이 아래 값만 바꾸면 됨. 활성화하려면 llama-cpp-python도 설치해야 함
# (requirements.txt에 기본 포함되지 않음 — requirements-local-gen.txt 참고).
# LOCAL_GEN_MODEL_URL=https://huggingface.co/<repo>/resolve/main/<file>.gguf
# LOCAL_GEN_MODEL_PATH=ai/data/local_gen_model.gguf
# LOCAL_GEN_N_CTX=1024
# LOCAL_GEN_THREADS=1
# LOCAL_GEN_MAX_TOKENS=220
# LOCAL_GEN_TIMEOUT=45
# LOCAL_GEN_CHAT_FORMAT=
