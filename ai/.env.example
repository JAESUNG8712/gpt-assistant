# ── LLM 제공자 선택 ──────────────────────────────────
# "auto"(기본, 폴백 체인 자동 사용) 또는 claude/zen/openrouter/groq/gemini/local 중 강제 지정
LLM_PROVIDER=auto

# ── Anthropic Claude (추천, 유료) ────────────────────
# 키 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── OpenCode Zen (무료 모델 게이트웨이) ───────────────
# 키 발급: https://opencode.ai/auth
OPENCODE_ZEN_API_KEY=
ZEN_MODEL=deepseek-v4-flash-free

# ── OpenRouter (무료 모델, 한도 없음) ─────────────────
# 키 발급: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Groq (무료, 하루 14,400건) ────────────────────────
# 키 발급: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (무료, 하루 1,500건) ────────────────
# 키 발급: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── DB 저장 (Turso 클라우드 — 권장) ───────────────────
# 가입: https://turso.tech (무료)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# 위 두 값을 설정하지 않으면 로컬 SQLite로 자동 전환 (재배포 시 데이터 유실 가능)
# DB_PATH=/app/data/memory.db

# ── 소유자·관리 API 접근 토큰 (필수) ──────────────────
# 일반 소유자 채팅은 X-Admin-Token 헤더, 관리 API는 token 파라미터로 검증한다.
# 미설정 시 공개되는 것이 아니라 소유자 채팅·관리 기능이 안전하게 차단된다.
BACKUP_TOKEN=

# ── 기억 개인정보·보존 정책 (선택, 아래는 기본값) ──────
# 검색 관측 질문은 원문 대신 HMAC으로 저장한다. 별도 salt가 없으면 BACKUP_TOKEN 사용.
MEMORY_TELEMETRY_SALT=
# 보존정책은 자동 실행되지 않으며 /admin/memory-retention 기본 호출은 미리보기만 한다.
CONVERSATION_RETENTION_DAYS=90
MEMORY_CANDIDATE_PENDING_DAYS=45
MEMORY_CANDIDATE_HISTORY_DAYS=365
MEMORY_RETRIEVAL_RETENTION_DAYS=30

# ── Google Drive 백업 (선택) ──────────────────────────
# Google Cloud Console에서 OAuth2 클라이언트 발급
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=

# ── 주식 분석 (선택) ───────────────────────────────────
DART_API_KEY=
BOK_API_KEY=
KRX_ID=
KRX_PW=

# ── 법령 검색 (선택) ───────────────────────────────────
# 키 발급: https://open.law.go.kr
# 2026-08-30부터 이 키는 "배포된 서버"(Render 등)에 설정해야 함 — GitHub Actions는
# git에 결과를 커밋하는 대신 POST /admin/refresh-law-cache를 호출해 서버가 직접
# 수집·저장하도록 바뀌었음(브랜치 불일치로 갱신분이 서비스에 반영 안 되던 문제 해결)
LAW_API_KEY=

# ── 여행경보(외교부 해외안전여행) 자동 수집 (선택) ─────────
# 키 발급: https://www.data.go.kr/data/15076237/openapi.do (활용신청 → 인증키 발급)
# LAW_API_KEY와 동일하게 "배포된 서버"에 설정 — GitHub Actions(update_travel_alerts.yml)는
# POST /admin/refresh-travel-alerts를 호출만 하고, 실제 수집·DB 저장은 서버가 수행함
TRAVEL_ALERT_API_KEY=
# 장기기억 출처별 기본 유효기간(일). 만료된 기억은 검색·답변 근거에서 자동 제외됩니다.
MEMORY_VALIDITY_LAW_DAYS=30
MEMORY_VALIDITY_WEB_DAYS=14
MEMORY_VALIDITY_KB_AUGMENTED_DAYS=180
MEMORY_VALIDITY_GENERATED_DAYS=90
MEMORY_VALIDITY_APPROVED_DAYS=180
MEMORY_VALIDITY_TRAVEL_DAYS=7
